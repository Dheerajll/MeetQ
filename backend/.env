# Environment variables for the backend
# Database credentials, JWT secrets, Ollama host, etc.
# Copy this to .env and fill in your actual values
# ============================================
# MeetQ Backend — Environment Configuration
# ============================================

# --- Application ---
APP_NAME=MeetQ Backend
DEBUG=true
SECRET_KEY=meetq-dev-secret-key-change-in-production

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=dheeraj
DB_NAME=meetq_db

# Full async connection URL (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:dheeraj@localhost:5432/meetq_db

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS (Frontend URL) ---
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (fill in later) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# --- Ollama (for later — summarization & RAG) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3